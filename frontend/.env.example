# Frontend API base URL (dev default points to backend on port 3001)
VITE_API_URL=http://localhost:3001

# Enable micro-frontend remotes (true/false).
# If false/empty, host renders local pages.
VITE_USE_MF=false

# Remote MF URLs (used when VITE_USE_MF=true)
VITE_REMOTE_AUTH_URL=https://och-net.ru/remote-auth
VITE_REMOTE_USER_URL=https://och-net.ru/remote-user
VITE_REMOTE_COMPANY_URL=https://och-net.ru/remote-company
