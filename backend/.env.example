# Backend HTTP port (dev default: 3001)
PORT=3001

# Absolute/relative path to SQLite DB file (optional, defaults to backend/data.db)
DB_PATH=

# JWT signing secret (required in production; app exits if missing/unsafe default)
JWT_SECRET=

# Comma-separated CORS allowlist for production (example: https://app.example.com,https://admin.example.com)
# If empty, all origins are allowed.
ALLOWED_ORIGINS=

# Frontend base URL for links in emails (reset/verify), e.g. https://och-net.ru
FRONTEND_URL=

# SMTP settings for transactional emails (password reset, email verification, booking notifications)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Optional sender identity (defaults: MAIL_FROM -> SMTP_USER, MAIL_FROM_NAME -> On)
MAIL_FROM=
MAIL_FROM_NAME=On

# AI provider settings (if OPENAI_API_KEY is empty, backend falls back to stub AI client)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_MS=15000

# B84: booking reminder scheduler interval in milliseconds (default: 900000 = 15 min)
BOOKING_REMINDER_INTERVAL_MS=900000
# B40: reminder lead times in minutes (comma-separated, e.g. 1440,60 for 24h and 1h reminders)
BOOKING_REMINDER_OFFSETS_MINUTES=1440

# B34: SQLite backup settings (used by `npm run backup`)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
