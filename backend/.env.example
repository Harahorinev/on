PORT=3001
# JWT_SECRET is required in production (app will exit if missing or default)
JWT_SECRET=
# In production, comma-separated list of allowed CORS origins (e.g. https://app.example.com). If empty, all origins are allowed.
ALLOWED_ORIGINS=

# B78: Frontend base URL for password reset link (e.g. https://app.example.com). If unset, reset email is not sent.
FRONTEND_URL=

# B78: SMTP for sending email (password reset, etc.). Recommended: Yandex. If unset, sendEmail no-ops.
# Yandex example:
# SMTP_HOST=smtp.yandex.ru
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your@yandex.ru
# SMTP_PASS=
# Optional: MAIL_FROM= (defaults to SMTP_USER), MAIL_FROM_NAME=

# B103: AI chat backend (assistant). If OPENAI_API_KEY is unset, a local stub client is used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# Optional: OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: AI_TIMEOUT_MS=15000
